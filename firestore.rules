rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /saved_numbers/{documentId} {
      allow read, write: if true;
    }
    match /users/{userId}/saved_numbers/{documentId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
